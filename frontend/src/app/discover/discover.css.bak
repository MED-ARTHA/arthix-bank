.dc { display: grid; gap: 28px; }
.dc-head h1 { margin-top: 6px; font-size: clamp(30px, 3.4vw, 42px); line-height: 1.1; }
.dc-head p:last-child { margin-top: 10px; max-width: 560px; font-size: 14px; color: #9b9cb3; }
.dc-tabs { display: flex; flex-wrap: wrap; gap: 6px; padding: 4px; width: fit-content; border-radius: 999px; border: 1px solid rgba(255,255,255,.1); }
.dc-tabs button { padding: 8px 18px; border-radius: 999px; font-size: 13px; color: #9b9cb3; transition: all .2s; }
.dc-tabs button:hover { color: #fff; }
.dc-tabs button.on { color: #fff; background: #7c6df0; }

.dc-grid { display: grid; gap: 40px 28px; grid-template-columns: repeat(auto-fill, minmax(280px, 1fr)); }
.dc-grid-coins { grid-template-columns: repeat(auto-fill, minmax(190px, 1fr)); }
.dc-grid-banks { gap: 22px; grid-template-columns: repeat(auto-fill, minmax(230px, 1fr)); }
.dc-item { display: grid; gap: 18px; justify-items: start; }
.dc-item-coin { justify-items: center; text-align: center; }
.dc-item figcaption b { font-family: var(--font-serif, Georgia), serif; font-size: 20px; font-weight: 400; }
.dc-item figcaption p { margin-top: 6px; font-size: 13px; line-height: 1.55; color: #9b9cb3; }
.dc-item figcaption small { display: block; margin-top: 8px; font-size: 11px; color: #6d6e86; }

/* ---- 3D objects (real photos) ---- */
.dc-stage { position: relative; perspective: 1000px; cursor: grab; user-select: none; touch-action: pan-y; }
.dc-stage:active { cursor: grabbing; }
.dc-stage::after { content: ""; position: absolute; left: 10%; right: 10%; bottom: -24px; height: 18px; border-radius: 50%; pointer-events: none;
  background: radial-gradient(closest-side, rgba(0,0,0,.6), transparent); filter: blur(4px); }
.dc-stage-note { width: min(340px, 100%); }
.dc-stage-coin { width: var(--d); height: var(--d); }
.dc-obj { position: relative; width: 100%; transform-style: preserve-3d; will-change: transform; }
.dc-stage-note .dc-obj { aspect-ratio: var(--ratio); }
.dc-coin-obj { height: 100%; }
.dc-sheet { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: fill; border-radius: 5px; pointer-events: none;
  backface-visibility: hidden; box-shadow: 0 20px 30px -20px #000; }
.dc-sheet-back { transform: rotateY(180deg); }
.dc-edge { position: absolute; inset: 0; border-radius: 50%; background: var(--edge); filter: brightness(.7); }
.dc-cface { position: absolute; inset: 0; width: 100%; height: 100%; border-radius: 50%; object-fit: cover; scale: 1.05;
  pointer-events: none; backface-visibility: hidden; }

/* ---- bank card ---- */.dc-bank { display: block; width: 100%; aspect-ratio: 1.586; perspective: 900px; text-align: left; border-radius: 16px; transition: translate .25s; }
.dc-bank:hover { translate: 0 -4px; }
.dc-bank-in { display: flex; height: 100%; flex-direction: column; justify-content: space-between; padding: 16px 18px; border-radius: inherit; color: #fff; position: relative; overflow: hidden;
  background: linear-gradient(140deg, var(--c1), var(--c2)); box-shadow: 0 22px 36px -22px #000, inset 0 0 0 1px rgba(255,255,255,.2);
  transform: rotateX(var(--rx, 0deg)) rotateY(var(--ry, 0deg)); transition: transform .3s ease-out; }
.dc-bank.on .dc-bank-in { box-shadow: 0 22px 36px -22px #000, 0 0 0 2px #fff; }
.dc-bank-in::after { content: ""; position: absolute; inset: 0; pointer-events: none;
  background: linear-gradient(115deg, transparent calc(30% + var(--ry, 0deg) * 4), rgba(255,255,255,.2) calc(48% + var(--ry, 0deg) * 4), transparent calc(66% + var(--ry, 0deg) * 4)); }
.dc-bank-top { display: flex; justify-content: space-between; align-items: center; font-size: 10px; letter-spacing: .18em; text-transform: uppercase; opacity: .9; }
.dc-bank-top i { width: 16px; height: 16px; border-radius: 50%; border: 2px solid rgba(255,255,255,.7); border-left-color: transparent; }
.dc-word { font-family: var(--font-serif, Georgia), serif; font-size: 20px; font-weight: 500; line-height: 1.15; }
.dc-logo { max-height: 38px; max-width: 70%; object-fit: contain; }
.dc-chip { width: 36px; height: 26px; border-radius: 5px; background: linear-gradient(135deg, #f1e6b8, #b8a266); }
.dc-detail { padding: 22px 26px; border-radius: 16px; border: 1px solid rgba(255,255,255,.1); background: #0b0b18; }
.dc-detail p { margin-top: 12px; max-width: 620px; font-size: 14px; line-height: 1.6; color: #b4b5cb; }
.dc-detail h3 { display: inline; margin-right: 12px; font-size: 24px; }
.dc-pill { padding: 3px 10px; border-radius: 999px; font-size: 11px; color: #cfcbf9; border: 1px solid rgba(167,157,255,.35); }

/* ---- culture + change ---- */
.dc-culture { display: grid; gap: 16px; grid-template-columns: repeat(auto-fill, minmax(260px, 1fr)); }
.dc-culture article { display: grid; gap: 10px; padding: 24px; align-content: start; }
.dc-culture svg { color: #a89ff5; }
.dc-culture h3 { font-size: 20px; }
.dc-culture p { font-size: 13.5px; line-height: 1.6; color: #9b9cb3; }
.dc-change { display: grid; gap: 18px 28px; padding: 26px; grid-template-columns: 1fr; }
@media (min-width: 900px) { .dc-change { grid-template-columns: 1.2fr auto 1.6fr; align-items: center; } }
.dc-change h2 { font-size: 22px; }
.dc-change p { margin-top: 6px; font-size: 13px; color: #9b9cb3; }
.dc-field { display: flex; align-items: center; gap: 10px; padding: 0 16px; height: 52px; border-radius: 12px; border: 1px solid rgba(255,255,255,.14); background: rgba(255,255,255,.04); }
.dc-field:focus-within { border-color: #7c6df0; }
.dc-field input { width: 120px; font-size: 22px; color: #fff; background: none; outline: none; font-family: var(--font-serif, Georgia), serif; }
.dc-field span { font-size: 12px; letter-spacing: .14em; color: #8b8ca3; }
.dc-parts { display: flex; flex-wrap: wrap; gap: 8px; }
.dc-parts li { padding: 7px 12px; border-radius: 999px; font-size: 13px; border: 1px solid rgba(167,157,255,.3); background: rgba(124,109,240,.1); }
.dc-parts b { font-weight: 500; color: #cfcbf9; }
@media (prefers-reduced-motion: reduce) { .dc-coin-in { animation: none; transform: rotateY(-18deg); } .dc-note-in, .dc-bank-in { transition: none; } }