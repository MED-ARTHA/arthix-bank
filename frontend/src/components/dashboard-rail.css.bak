.rail { display: grid; gap: 16px; min-width: 0; }
.rail-card { padding: 20px 22px; border-radius: 16px; }
.rail-card header { display: flex; align-items: baseline; justify-content: space-between; gap: 12px; margin-bottom: 14px; }
.rail-card h3 { font-size: 14px; font-weight: 500; }
.rail-card header a { font-size: 11px; letter-spacing: 0.04em; color: #8b8ca3; }
.rail-card header a:hover { color: #fff; }

.rail-pay { display: grid; grid-template-columns: 1fr 1fr; gap: 8px; }
.rail-pay a {
  display: flex; align-items: center; gap: 10px; padding: 11px 12px; border-radius: 10px; font-size: 12.5px; color: #cfd0e0;
  border: 1px solid rgba(255, 255, 255, 0.07); background: rgba(255, 255, 255, 0.025); transition: border-color 0.2s, background 0.2s;
}
.rail-pay a:hover { border-color: rgba(167, 157, 255, 0.45); background: rgba(124, 109, 240, 0.1); }
.rail-pay svg { flex-shrink: 0; color: #a89ff5; }

/* bank logos sit on light tiles so any logo stays readable */
.rail-logos { display: grid; grid-template-columns: repeat(3, 1fr); gap: 8px; }
.rail-logos a {
  display: grid; place-items: center; height: 58px; padding: 8px 10px; border-radius: 10px;
  background: linear-gradient(160deg, #fcfcfe, #e9eaf2); box-shadow: inset 0 0 0 1px rgba(0, 0, 0, 0.05);
  transition: transform 0.2s, box-shadow 0.2s;
}
.rail-logos a:hover { transform: translateY(-2px); box-shadow: 0 10px 20px -10px rgba(0, 0, 0, 0.7); }
.rail-logos img { max-width: 100%; max-height: 32px; object-fit: contain; }
.rail-logos b { font-size: 11px; font-weight: 500; text-align: center; color: #1a1a2e; }