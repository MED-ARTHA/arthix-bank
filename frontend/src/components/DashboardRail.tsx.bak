"use client";

import "./dashboard-rail.css";
import { useState } from "react";
import Link from "next/link";
import { Bus, GraduationCap, Landmark, Shield, Smartphone, Zap, type LucideIcon } from "lucide-react";
import { BANKS, type Bank } from "@/lib/moroccan";

const PAY: { label: string; icon: LucideIcon }[] = [
  { label: "Telecom", icon: Smartphone },
  { label: "Electricity & water", icon: Zap },
  { label: "Taxes", icon: Landmark },
  { label: "Schools", icon: GraduationCap },
  { label: "Insurance", icon: Shield },
  { label: "Transport", icon: Bus },
];

function LogoTile({ bank }: { bank: Bank }) {
  const [broken, setBroken] = useState(false);
  return (
    <li>
      <Link href="/discover" title={bank.name} aria-label={bank.name}>
        {bank.logo && !broken ? (
          // eslint-disable-next-line @next/next/no-img-element
          <img src={bank.logo} alt="" draggable={false} onError={() => setBroken(true)} />
        ) : (
          <b>{bank.name}</b>
        )}
      </Link>
    </li>
  );
}

export default function DashboardRail() {
  const banks = BANKS.filter((b) => b.logo);
  return (
    <aside className="rail">
      <section className="card rail-card rise">
        <header>
          <h3>Pay & top up</h3>
          <Link href="/payments">All payments</Link>
        </header>
        <div className="rail-pay">
          {PAY.map(({ label, icon: Icon }) => (
            <Link key={label} href="/payments">
              <Icon size={17} strokeWidth={1.5} />
              {label}
            </Link>
          ))}
        </div>
      </section>

      <section className="card rail-card rise">
        <header>
          <h3>Moroccan banks</h3>
          <Link href="/discover">Discover</Link>
        </header>
        <ul className="rail-logos">
          {banks.map((b) => <LogoTile key={b.id} bank={b} />)}
        </ul>
      </section>
    </aside>
  );
}